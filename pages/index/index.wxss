.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 48rpx 32rpx 64rpx;
}

.hero {
    display: flex;
    flex-direction: column;
    margin-bottom: 32rpx;
}

.eyebrow {
    color: #1769e0;
    font-size: 22rpx;
    font-weight: 600;
    letter-spacing: 3rpx;
}

.title {
    margin-top: 16rpx;
    font-size: 52rpx;
    font-weight: 700;
    line-height: 1.25;
}

.subtitle {
    margin-top: 12rpx;
    color: #646a73;
    font-size: 28rpx;
}

.level-bar {
    display: flex;
    margin-bottom: 28rpx;
    gap: 16rpx;
}

.level-pill {
    padding: 14rpx 28rpx;
    font-size: 26rpx;
    color: #646a73;
    background: #ffffff;
    border: 2rpx solid #e5e8eb;
    border-radius: 999rpx;
}

.level-pill-active {
    color: #ffffff;
    background: #1769e0;
    border-color: #1769e0;
    font-weight: 600;
}

.article-card {
    margin-bottom: 24rpx;
}

.article-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.article-topic {
    color: #1769e0;
    font-size: 22rpx;
    font-weight: 600;
}

.article-level {
    color: #646a73;
    font-size: 22rpx;
}

.article-title {
    display: block;
    margin-top: 16rpx;
    font-size: 32rpx;
    font-weight: 700;
    line-height: 1.4;
}

.article-title-cn {
    display: block;
    margin-top: 8rpx;
    color: #646a73;
    font-size: 26rpx;
}

.article-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 20rpx;
    color: #8a94a6;
    font-size: 22rpx;
}

.article-audio {
    color: #1769e0;
}

.state-card-error {
    border-color: #ffd8d6;
}

.gen-panel {
    margin-top: 12rpx;
}

.gen-title {
    font-size: 30rpx;
    font-weight: 600;
}

.gen-topics {
    display: flex;
    margin-top: 20rpx;
    flex-wrap: wrap;
    gap: 14rpx;
}

.topic-chip {
    padding: 10rpx 24rpx;
    font-size: 24rpx;
    color: #1769e0;
    background: #eaf2ff;
    border-radius: 999rpx;
}

.gen-input {
    height: 80rpx;
    padding: 0 24rpx;
    margin-top: 24rpx;
    font-size: 28rpx;
    color: #1f2329;
    background: #f4f6fb;
    border-radius: 18rpx;
}

.gen-placeholder {
    color: #a8b1c0;
}
