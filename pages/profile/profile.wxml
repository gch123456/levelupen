<view class="page">
    <view class="state-card" wx:if="{{authState === 'checking'}}">
        <view class="spinner"></view>
        <text class="state-title">正在检查登录</text>
    </view>

    <view class="login-wrap" wx:elif="{{authState === 'signed-out'}}">
        <text class="page-hint">登录后查看学习统计</text>
        <login-panel bind:signedin="onSignedIn" />
    </view>

    <block wx:else>
        <view class="card profile-card">
            <view class="avatar">{{user.name ? 'Me' : '?'}}</view>
            <view class="profile-info">
                <text class="profile-name">{{user.name || '学习者'}}</text>
                <text class="profile-desc">每天进步一点点</text>
            </view>
        </view>

        <view class="card stats-card">
            <view class="stat">
                <text class="stat-num">{{wordCount}}</text>
                <text class="stat-label">生词</text>
            </view>
            <view class="stat">
                <text class="stat-num">{{speakingCount}}</text>
                <text class="stat-label">口语练习</text>
            </view>
        </view>

        <button class="primary-button signout" bindtap="signOut">退出登录</button>
    </block>
</view>
