.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 48rpx 32rpx 64rpx;
}

.login-wrap {
    margin-top: 120rpx;
}

.page-hint {
    display: block;
    margin-bottom: 24rpx;
    color: #646a73;
    font-size: 28rpx;
    text-align: center;
}

.profile-card {
    display: flex;
    align-items: center;
}

.avatar {
    display: flex;
    width: 108rpx;
    height: 108rpx;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #eaf2ff;
    color: #1769e0;
    font-size: 40rpx;
    font-weight: 700;
}

.profile-info {
    margin-left: 28rpx;
    display: flex;
    flex-direction: column;
}

.profile-name {
    font-size: 34rpx;
    font-weight: 700;
}

.profile-desc {
    margin-top: 8rpx;
    color: #8a94a6;
    font-size: 24rpx;
}

.stats-card {
    margin-top: 24rpx;
    display: flex;
}

.stat {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.stat-num {
    font-size: 48rpx;
    font-weight: 700;
    color: #1769e0;
}

.stat-label {
    margin-top: 8rpx;
    color: #646a73;
    font-size: 24rpx;
}

.signout {
    margin-top: 48rpx;
}
