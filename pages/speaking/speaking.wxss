.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 32rpx 32rpx 64rpx;
}

.login-wrap {
    margin-top: 120rpx;
}

.page-hint {
    display: block;
    margin-bottom: 24rpx;
    color: #646a73;
    font-size: 28rpx;
    text-align: center;
}

.hero {
    display: flex;
    flex-direction: column;
    margin-bottom: 32rpx;
}

.eyebrow {
    color: #1769e0;
    font-size: 22rpx;
    font-weight: 600;
    letter-spacing: 3rpx;
}

.title {
    margin-top: 16rpx;
    font-size: 44rpx;
    font-weight: 700;
    line-height: 1.25;
}

.subtitle {
    margin-top: 12rpx;
    color: #646a73;
    font-size: 28rpx;
}

.scenario-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20rpx;
}

.scenario-label {
    font-size: 30rpx;
    font-weight: 600;
}

.scenario-arrow {
    color: #1769e0;
    font-size: 30rpx;
}

.chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24rpx;
}

.chat-scenario {
    font-size: 32rpx;
    font-weight: 700;
}

.chat-exit {
    padding: 8rpx 24rpx;
    font-size: 24rpx;
    color: #646a73;
    background: #ffffff;
    border: 2rpx solid #e5e8eb;
    border-radius: 999rpx;
}

.chat-body {
    display: flex;
    flex-direction: column;
}

.msg {
    display: flex;
    flex-direction: column;
    margin-bottom: 28rpx;
}

.msg-user {
    align-items: flex-end;
}

.msg-assistant {
    align-items: flex-start;
}

.bubble {
    max-width: 560rpx;
    padding: 22rpx 26rpx;
    font-size: 28rpx;
    line-height: 1.6;
    border-radius: 22rpx;
}

.bubble-user {
    color: #ffffff;
    background: #1769e0;
    border-bottom-right-radius: 6rpx;
}

.bubble-assistant {
    color: #1f2329;
    background: #ffffff;
    border: 2rpx solid #e5e8eb;
    border-bottom-left-radius: 6rpx;
}

.follow-read {
    margin-top: 12rpx;
    padding: 10rpx 24rpx;
    font-size: 24rpx;
    color: #1769e0;
    background: #eaf2ff;
    border-radius: 999rpx;
}

.review-box {
    display: flex;
    align-items: center;
    margin-top: 12rpx;
    padding: 16rpx 24rpx;
    background: #f8f9fb;
    border-radius: 16rpx;
    max-width: 560rpx;
}

.review-text {
    font-size: 24rpx;
    color: #41464f;
    line-height: 1.6;
}

.spinner-small {
    width: 28rpx;
    height: 28rpx;
    border: 4rpx solid #dbe8fb;
    border-top-color: #1769e0;
    border-radius: 50%;
    margin-right: 12rpx;
}

.chat-input-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    box-sizing: border-box;
    padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
    background: #ffffff;
    border-top: 2rpx solid #e5e8eb;
}

.chat-input {
    flex: 1;
    height: 76rpx;
    padding: 0 24rpx;
    font-size: 28rpx;
    background: #f4f6fb;
    border-radius: 999rpx;
}

.chat-placeholder {
    color: #a8b1c0;
}

.chat-send {
    flex-shrink: 0;
    margin-left: 20rpx;
    padding: 0 36rpx;
    height: 76rpx;
    line-height: 76rpx;
    font-size: 28rpx;
    font-weight: 600;
    color: #ffffff;
    background: #1769e0;
    border-radius: 999rpx;
}

.chat-send-disabled {
    opacity: 0.5;
}

.record-hint {
    display: block;
    margin-top: 8rpx;
    color: #e5484d;
    font-size: 22rpx;
}
